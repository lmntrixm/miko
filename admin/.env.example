# Admin sign-in (server-side). All four are required in production.
ADMIN_EMAIL=name@[domain]
ADMIN_PASSWORD_HASH=
# Base32 secret you also add to the Authenticator app
ADMIN_TOTP_SECRET=
# At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=
# Local demo only (admin@miko.test / password123 / code from secret JBSWY3DPEHPK3PXP): ADMIN_DEMO=1
