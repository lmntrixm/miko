{
  "spacing": {
    "space-1": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Icon-to-label gap, tight stacks."
    },
    "space-2": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Between chips and inline badges."
    },
    "space-3": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Between list cards."
    },
    "space-4": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Card padding."
    },
    "space-5": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Mobile page side margin."
    },
    "space-6": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Between sections on mobile."
    },
    "space-7": {
      "$type": "dimension",
      "$value": "28px",
      "$description": "Admin page margin."
    },
    "space-8": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "Between large sections."
    },
    "space-9": {
      "$type": "dimension",
      "$value": "56px",
      "$description": "Header breathing room."
    }
  },
  "radius": {
    "radius-xs": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Tags, badges, small pills."
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Admin buttons and fields."
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Icon buttons, covers."
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "18px",
      "$description": "List cards, admin panels."
    },
    "radius-xl": {
      "$type": "dimension",
      "$value": "22px",
      "$description": "Large cards, banners."
    },
    "radius-2xl": {
      "$type": "dimension",
      "$value": "26px",
      "$description": "Auth fields and hero buttons."
    },
    "radius-sheet": {
      "$type": "dimension",
      "$value": "28px",
      "$description": "Top corners of bottom sheets."
    },
    "radius-hero": {
      "$type": "dimension",
      "$value": "42px",
      "$description": "Glass auth card."
    },
    "radius-full": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "Dots, avatars, switches."
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Vazirmatn",
          "Tahoma",
          "sans-serif"
        ]
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "40px",
        "fontWeight": 900,
        "lineHeight": "52px"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "26px",
        "fontWeight": 900,
        "lineHeight": "36px"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "20px",
        "fontWeight": 900,
        "lineHeight": "28px"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": 900,
        "lineHeight": "24px"
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "15px",
        "fontWeight": 500,
        "lineHeight": "27px"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": "26px"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": "20px"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "11px",
        "fontWeight": 700,
        "lineHeight": "16px"
      }
    }
  }
}